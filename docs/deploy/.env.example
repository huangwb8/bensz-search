# Copy to .env for a real deployment; use a fresh secret. Do not commit .env.
LITELLM_MASTER_KEY=
BENSZ_SEARCH_SECRET=
BENSZ_SEARCH_ADMIN_USERNAME=admin
BENSZ_SEARCH_ADMIN_PASSWORD=
BENSZ_SEARCH_COOKIE_SECURE=false
# HTTPS reverse proxy: set COOKIE_SECURE=true and trust its actual container IP.
# Recheck this address if the proxy container is recreated; do not use '*'.
FORWARDED_ALLOW_IPS=127.0.0.1
BENSZ_SEARCH_PORT=8898
# Server docker-compose.yml only; leave empty to use the default latest image.
BENSZ_SEARCH_IMAGE=
EXA_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
OPENAI_SEARCH_API_BASE=https://api.openai.com/v1
OPENAI_SEARCH_MODEL=gpt-4.1-mini
SEARXNG_API_BASE=http://host.docker.internal:8080
# Enable these engines in the instance too; leave empty to use its defaults.
SEARXNG_ENGINES=google,bing,duckduckgo,brave,baidu,wikipedia,github,stackoverflow,pubmed,arxiv,google news

# Versioned search protocol (single process; request limits are not billing guarantees)
BENSZ_SEARCH_PROTOCOL_ENABLED=true
BENSZ_SEARCH_MCP_ENABLED=true
BENSZ_SEARCH_MAX_CALLS=10
BENSZ_SEARCH_CONCURRENCY=3
BENSZ_SEARCH_TENANT_CONCURRENCY=4
BENSZ_SEARCH_REQUESTS_PER_MINUTE=60
BENSZ_SEARCH_SNIPPET_CHARS=2000
BENSZ_SEARCH_RESPONSE_BYTES=128000
# Add the HTTPS proxy's exact Host/Origin for remote MCP clients.
BENSZ_SEARCH_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
BENSZ_SEARCH_MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
